{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gateaway.cloud/ai-catalog.schema.json",
  "title": "DevSandbox AI Catalog",
  "description": "Validation schema for the AI Catalog v0.9 document published by DevSandbox.",
  "type": "object",
  "required": ["specVersion", "entries"],
  "properties": {
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "AI Catalog specification version."
    },
    "host": {
      "type": "object",
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string" },
        "identifier": { "type": "string" },
        "documentationUrl": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string", "format": "uri" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "type"],
        "properties": {
          "identifier": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "version": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri" },
          "data": {},
          "extensions": { "type": "object" }
        },
        "oneOf": [
          { "required": ["url"] },
          { "required": ["data"] }
        ]
      }
    },
    "extensions": { "type": "object" },
    "signature": { "type": "object" }
  }
}
