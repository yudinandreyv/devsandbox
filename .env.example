# Copy to .env and replace every value with local secrets. Do not commit .env.
POSTGRES_ADMIN_PASSWORD=replace-with-local-postgres-password
SANDBOX_READONLY_PASSWORD=replace-with-local-readonly-password
DATABASE_READONLY_URL=postgresql://sandbox_readonly:replace-with-local-readonly-password@db:5432/sandbox_db
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
